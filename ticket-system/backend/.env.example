# =====================================================================
#  Backend — variáveis de ambiente (copie para .env e preencha)
# =====================================================================

# --- Aplicação ---
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# IMPORTANTE: o cálculo de SLA usa hora local de Portugal continental.
# Mantenha o processo no fuso de Lisboa.
TZ=Europe/Lisbon

# --- Base de dados (PostgreSQL) ---
DATABASE_URL=postgres://ticket:ticket@localhost:5432/ticketdb

# --- Autenticação (JWT) ---
JWT_SECRET=mude-isto-para-um-segredo-longo-e-aleatorio
JWT_EXPIRY=12h

# --- SLA (horas úteis) ---
SLA_HORA_INICIO=09:30
SLA_HORA_FIM=19:00
SLA_MINUTOS_UTEIS=120
# Feriados adicionais opcionais (MM-DD, separados por vírgula). Ex.: feriado municipal
# FERIADOS_EXTRA=06-13

# --- Triagem ---
TRIAGEM_CATEGORIA_PADRAO=comercial
TRIAGEM_CACHE_TTL_MS=60000

# --- Locking ---
LOCK_RELEASE_MINUTES=5

# --- Microsoft Graph (Office 365) ---
# Registo de aplicação no Azure AD (app-only). Permissões com consentimento de
# administrador: Mail.Read, Mail.Send (e Mail.ReadWrite se quiser marcar como lido).
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Caixa de correio PARTILHADA (UPN ou email), ex.: suporte@empresa.pt
MS_SHARED_MAILBOX=
# URL PÚBLICA HTTPS que a Graph vai chamar (em dev use um túnel, ex.: ngrok)
MS_WEBHOOK_URL=https://o-seu-dominio.pt/api/webhooks/graph
# Segredo partilhado para validar as notificações
MS_CLIENT_STATE=segredo-de-validacao-webhook
